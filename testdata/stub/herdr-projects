#!/usr/bin/env bash
# Stub of herdr-projects for E2E: serves fixture JSON and logs every call.
# Write commands only log (and their stdin); a few fixture threads refuse the
# way the real binary does so the UI's error paths can be driven.
D="$(cd "$(dirname "$0")" && pwd)"
echo "herdr-projects $*" >> "${STUB_LOG:-/dev/null}"
ROOT=""
[ "$1" = "--root" ] && { ROOT="$2"; shift 2; }
logstdin() { local s; s="$(cat)"; printf 'stdin: %s\n' "${s//$'\n'/\\n}" >> "${STUB_LOG:-/dev/null}"; }
# The Master window's bulk actions (stage 1b): a file fail-<command>-<slug>
# next to this script makes that command fail for that project, so the E2E
# can trip the circuit breaker.
for c in pause resume set sweep open coordinator; do
  if [ "$1" = "$c" ]; then
    s="$2"; [ "$c" = coordinator ] && s="$3"
    if [ -f "$D/fail-$c-$s" ]; then [ "$c" = coordinator ] && logstdin; echo "herdr-projects: stub fails $c for $s" >&2; exit 1; fi
  fi
done
# setstatus SLUG STATUS rewrites a generated fleet's list.tsv, so a pause or
# resume shows in the next `list`, and touches PROJECT.md as the real one
# writes it (Dash re-lists when a PROJECT.md changes).
setstatus() { [ -f "$D/list.tsv" ] && sed -i "s#^$1\t[a-z]*\t#$1\t$2\t#" "$D/list.tsv"; [ -n "$ROOT" ] && touch "$ROOT/$1/PROJECT.md"; }
case "$1 $2" in
  "pause "*)
    setstatus "$2" paused
    echo "paused $2" ;;
  "resume "*)
    setstatus "$2" active
    echo "resumed $2" ;;
  "set "*)
    # Writes PROJECT.md's front matter like the real one: replace the key, or
    # add it before the closing +++.
    f="$ROOT/$2/PROJECT.md"
    [ -f "$f" ] || { echo "error: no project $2" >&2; exit 1; }
    case "$3" in
      max_parallel_threads|nudge|mute) ;;
      *) echo "error: unknown setting $3" >&2; exit 1 ;;
    esac
    if grep -q "^$3 = " "$f"; then sed -i "s#^$3 = .*#$3 = $4#" "$f"; else awk -v l="$3 = $4" 'NR>1 && /^\+\+\+$/ && !d {print l; d=1} {print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; fi
    echo "$2: $3 = $4" ;;
  "sweep "*)
    [ "$3" = "--dry-run" ] || { echo "stub: sweep without --dry-run refused" >&2; exit 2; }
    echo "$2: would remove worktree hp/$2/t-0001 (merged), tab $2:t9 (no pane)" ;;
  "list "*|"list")
    # A generated fleet (e2e/fleet-fixtures.mjs) brings its own list.
    if [ -f "$D/list.tsv" ]; then cat "$D/list.tsv"; else printf 'alpha\tactive\tWorking: 1\nbeta\tactive\tLanding: 1\ngamma\tpaused\tWorking: 1\n'; fi ;;
  "thread list")
    f="$D/thread-list-$3.json"
    [ -f "$f" ] || { echo "error: no project $3" >&2; exit 1; }
    # STUB_WT moves the fixture thread folders somewhere writable.
    sed "s#/fixture/wt/#${STUB_WT:-/fixture/wt}/#g" "$f" ;;
  "thread prompt")
    logstdin
    case "$3/$4" in
      alpha/t-0002) echo "herdr-projects: agent_blocked: t-0002 is waiting on a prompt in its pane (w1B:p1); \`thread read\` shows it, \`thread keys\` answers it" >&2; exit 1 ;;
      beta/t-0002) echo "herdr-projects: prompt_unconfirmed: the text was typed into t-0002's pane (w2B:p1) but the agent was not seen starting on it (timeout). Do not send it again" >&2; exit 1 ;;
    esac
    echo "sent to $4" ;;
  "thread keys")
    # STUB_SCREENS/<slug>_<id>.pane names the thread's pane (":" as "_");
    # with <pane>.onkeys there, the pane shows that file after the keys.
    m="${STUB_SCREENS:-/nonexistent}/$3_$4.pane"
    if [ -f "$m" ] && [ -f "$STUB_SCREENS/$(cat "$m").onkeys" ]; then mv "$STUB_SCREENS/$(cat "$m").onkeys" "$STUB_SCREENS/$(cat "$m")"; fi
    echo "$4 (agent was blocked): pressed keys" ;;
  "thread ack")
    [ "$3/$4" = "beta/t-0001" ] && { echo "herdr-projects: stub refuses to ack beta/t-0001" >&2; exit 1; }
    echo "$4: report acknowledged" ;;
  "thread next") echo "sent Next line to $4" ;;
  "thread resolve") echo "$4 resolved" ;;
  "thread restart")
    # The agent is back: the pane's exited marker (STUB_SCREENS/<slug>_<id>.pane) goes.
    m="${STUB_SCREENS:-/nonexistent}/$3_$4.pane"
    [ -f "$m" ] && rm -f "$STUB_SCREENS/$(cat "$m").noagent"
    echo "restarted $4 in its pane" ;;
  "coordinator prompt")
    logstdin
    [ "$3" = "beta" ] && { echo "herdr-projects: no coordinator of \`beta\` can take a prompt right now; \`open beta\` starts one" >&2; exit 1; }
    echo "sent to the coordinator in pane w1Z:p1 (agent was done)" ;;
  "open "*)
    [ "$2" = "beta" ] && { echo "herdr-projects: stub refuses to open beta" >&2; exit 1; }
    m="${STUB_SCREENS:-/nonexistent}/hub_$2.pane"
    [ -f "$m" ] && rm -f "$STUB_SCREENS/$(cat "$m").noagent"
    echo "resuming session 44444444 in pane w1Z:p1" ;;
  "progress --pane")
    f="$D/progress-${3//:/_}.json"
    if [ -f "$f" ]; then cat "$f"; else echo null; fi ;;
  "safety show")
    f="$D/safety-$3.txt"
    [ -f "$f" ] || { echo "error: no project $3" >&2; exit 1; }
    cat "$f" ;;
  *) echo "stub: unsupported: $*" >&2; exit 2 ;;
esac
