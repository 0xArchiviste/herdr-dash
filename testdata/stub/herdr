#!/usr/bin/env bash
# Stub of herdr for E2E: serves fixture JSON and logs every call.
# `pane read` serves a screen whose newest lines are at the bottom;
# `--source visible` acts like a pane someone scrolled up in herdr: it misses
# the last lines, so only `--source recent` shows the newest output.
# STUB_SCREENS/<pane>.alt makes the pane an alternate-screen TUI (Codex):
# `--source recent` reads blank, `--source detection` reads the screen.
D="$(cd "$(dirname "$0")" && pwd)"
# STUB_SCREENS/<pane>.noagent: the agent in that pane exited; herdr lists the
# pane with no agent and status unknown, and a shell in the foreground.
# STUB_SCREENS/<pane>.fg names another foreground program (vim, sleep).
if [ "$1 $2" = "pane send-text" ]; then
  echo "herdr pane send-text $3 $(printf '%q' "$4")" >> "${STUB_LOG:-/dev/null}"
else
  echo "herdr $*" >> "${STUB_LOG:-/dev/null}"
fi
noagent() { sed -E '/"pane_id":"'"$1"'"/{s/"agent":"[a-z]*",//;s/"agent_session":\{[^}]*\},//;s/"agent_status":"[a-z]*"/"agent_status":"unknown"/}'; }
case "$1 $2" in
  "pane list")
    # STUB_SCREENS/<pane>.status overrides a pane's agent_status.
    out="$(cat "${STUB_PANES:-$D/panes.json}")"
    for f in "${STUB_SCREENS:-/nonexistent}"/*.status; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .status)"; p="${p/_/:}"
      out="$(printf '%s\n' "$out" | sed "/\"pane_id\":\"$p\"/s/\"agent_status\":\"[a-z]*\"/\"agent_status\":\"$(cat "$f")\"/")"
    done
    for f in "${STUB_SCREENS:-/nonexistent}"/*.noagent; do
      [ -f "$f" ] || continue
      p="$(basename "$f" .noagent)"; p="${p/_/:}"
      out="$(printf '%s\n' "$out" | noagent "$p")"
    done
    printf '%s\n' "$out" ;;
  "pane read")
    pane="$3"; src=""; lines=""
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in --source) src="$2"; shift ;; --lines) lines="$2"; shift ;; esac
      shift
    done
    screen() {
      # STUB_SCREENS names a folder: a file named after the pane (":" as
      # "_") is that pane's whole screen, so tests can show a prompt.
      if [ -n "${STUB_SCREENS:-}" ] && [ -f "$STUB_SCREENS/${pane/:/_}" ]; then
        cat "$STUB_SCREENS/${pane/:/_}"
        return
      fi
      # STUB_REDRAW names a file: while it exists the pane shows a full-screen
      # TUI frame that shares no line with its history.
      if [ -n "${STUB_REDRAW:-}" ] && [ -e "$STUB_REDRAW" ]; then
        for i in $(seq 1 30); do echo "full-screen frame row $i"; done
        echo "frame clock $(date +%s%N)"
        return
      fi
      # STUB_T0 (epoch seconds) gives a long, growing history: 2400 lines,
      # plus two more every second, each line unique and stable.
      h=50
      if [ -n "${STUB_T0:-}" ]; then h=$(( 2400 + 2 * ($(date +%s) - STUB_T0) )); fi
      seq -f "scrollback line %.0f" 1 "$h"
      echo "clock $(date +%s%N)" # every read differs, like a live agent
      printf 'screen of %s\n❯ waiting for approval <b>bold?</b>\nLAST LINE of %s\n' "$pane" "$pane"
    }
    # A long read takes a while, so concurrent readers would overlap.
    if [ "${lines:-0}" -gt 60 ]; then sleep 0.3; fi
    if [ -n "${STUB_SCREENS:-}" ] && [ -f "$STUB_SCREENS/${pane/:/_}.alt" ] && [ "$src" != "detection" ]; then
      printf '\n\n\n'
    elif [ "$src" = "visible" ]; then screen | head -n -9; else screen; fi | tail -n "${lines:-+1}" ;;
  "pane get")
    # The pane's row from panes.json; STUB_SCREENS/<pane>.status overrides
    # its agent_status.
    row="$(grep -F "\"pane_id\":\"$3\"" "$D/panes.json" | sed 's/,$//')"
    [ -n "$row" ] || { echo "error: no pane $3" >&2; exit 1; }
    if [ -n "${STUB_SCREENS:-}" ] && [ -f "$STUB_SCREENS/${3/:/_}.status" ]; then
      row="$(printf '%s' "$row" | sed "s/\"agent_status\":\"[a-z]*\"/\"agent_status\":\"$(cat "$STUB_SCREENS/${3/:/_}.status")\"/")"
    fi
    if [ -n "${STUB_SCREENS:-}" ] && [ -f "$STUB_SCREENS/${3/:/_}.noagent" ]; then row="$(printf '%s' "$row" | noagent "$3")"; fi
    printf '{"id":"cli:pane:get","result":{"pane":%s,"type":"pane_info"}}\n' "$row" ;;
  "pane process-info")
    pane="$4"; f="${STUB_SCREENS:-/nonexistent}/${pane/:/_}"
    grep -qF "\"pane_id\":\"$pane\"" "$D/panes.json" || { echo "error: no pane $pane" >&2; exit 1; }
    if [ -f "$f.fg" ]; then fg="$(cat "$f.fg")"; pg=4243
    elif [ -f "$f.noagent" ]; then fg=bash; pg=4242
    else fg="$(grep -F "\"pane_id\":\"$pane\"" "$D/panes.json" | sed -E 's/.*"agent":"([a-z]*)".*/\1/')"; pg=4243; fi
    printf '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":%s,"foreground_processes":[{"argv":["%s"],"name":"%s","pid":%s}],"pane_id":"%s","shell_pid":4242},"type":"pane_process_info"}}\n' "$pg" "$fg" "$fg" "$pg" "$pane" ;;
  "pane send-keys"|"pane send-text")
    # STUB_SCREENS/<pane>.onkeys: after a key press the pane shows that file
    # (an agent moving on); the marker is used up.
    f="${STUB_SCREENS:-/nonexistent}/${3/:/_}"
    if [ "$1 $2" = "pane send-keys" ] && [ -f "$f.onkeys" ]; then mv "$f.onkeys" "$f"; fi
    # Text typed into a pane whose agent exited shows on its screen, like a shell echoing it.
    if [ "$1 $2" = "pane send-text" ] && [ -f "$f.noagent" ]; then
      printf '%s\n' "$4" | tr -d '\000-\010\013-\037' | sed 's/\[20[01]~//g' | sed 's/^/$ /' >> "$f"
    fi
    echo "ok" ;;
  *) echo "stub: unsupported: $*" >&2; exit 2 ;;
esac
